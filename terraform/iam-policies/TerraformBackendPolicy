{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "TerraformStateBucket",
			"Effect": "Allow",
			"Action": [
				"s3:CreateBucket",
			    "s3:GetBucketLocation",
				"s3:DeleteBucket",
				"s3:ListBucket",
				"s3:GetBucketLocation",
				"s3:GetBucketPolicy",
				"s3:PutBucketPolicy",
				"s3:GetBucketVersioning",
				"s3:PutBucketVersioning",
				"s3:GetEncryptionConfiguration",
				"s3:PutEncryptionConfiguration",
				"s3:GetBucketPublicAccessBlock",
                "s3:ListBucketVersions",
				"s3:PutBucketPublicAccessBlock"
			],
			"Resource": "arn:aws:s3:::riva-ecommerce-terraform-state"
		},
		{
			"Sid": "TerraformStateObjects",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject",
                "s3:DeleteObjectVersion"
			],
			"Resource": "arn:aws:s3:::riva-ecommerce-terraform-state/*"
		},
		{
			"Sid": "TerraformLockTable",
			"Effect": "Allow",
			"Action": [
				"dynamodb:CreateTable",
				"dynamodb:DescribeTable",
				"dynamodb:GetItem",
				"dynamodb:PutItem",
				"dynamodb:DeleteItem"
			],
			"Resource": "arn:aws:dynamodb:us-east-1:632638637512:table/terraform-lock"
		},
		{
  "Sid": "AnsibleSSMBucket",
  "Effect": "Allow",
  "Action": [
    "s3:GetBucketLocation",
    "s3:ListBucket"
  ],
  "Resource": "arn:aws:s3:::ecommerce-devops-ansible-ssm-632638637512"
},
{
  "Sid": "AnsibleSSMBucketObjects",
  "Effect": "Allow",
  "Action": [
    "s3:GetObject",
    "s3:PutObject",
    "s3:DeleteObject"
  ],
  "Resource": "arn:aws:s3:::ecommerce-devops-ansible-ssm-632638637512/*"
}
]
}