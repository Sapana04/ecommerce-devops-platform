pipeline {

    agent any

    environment {

        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '632638637512'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        AUTH_IMAGE = 'auth-service'
        PRODUCT_IMAGE = 'product-service'

        IMAGE_TAG = "${BUILD_NUMBER}"

        ANSIBLE_DIR = 'ansible'
    }


    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(logRotator(numToKeepStr: '10'))
    }


    stages {


        stage('Checkout Source Code') {

            steps {

                checkout scm
            }
        }


        stage('Build Auth Service Image') {

            steps {

                dir('services/auth-service') {

                    sh """
                    docker build \
                    -t ${AUTH_IMAGE}:${IMAGE_TAG} .
                    """
                }
            }
        }


        stage('Build Product Service Image') {

            steps {

                dir('services/product-service') {

                    sh """
                    docker build \
                    -t ${PRODUCT_IMAGE}:${IMAGE_TAG} .
                    """
                }
            }
        }


        stage('Login to Amazon ECR') {

            steps {

                sh """

                aws ecr get-login-password \
                --region ${AWS_REGION} | \
                docker login \
                --username AWS \
                --password-stdin ${ECR_REGISTRY}

                """
            }
        }


        stage('Tag Docker Images') {

            steps {

                sh """

                docker tag ${AUTH_IMAGE}:${IMAGE_TAG} \
                ${ECR_REGISTRY}/${AUTH_IMAGE}:${IMAGE_TAG}


                docker tag ${PRODUCT_IMAGE}:${IMAGE_TAG} \
                ${ECR_REGISTRY}/${PRODUCT_IMAGE}:${IMAGE_TAG}

                """
            }
        }


        stage('Push Images to ECR') {

            steps {

                sh """

                docker push \
                ${ECR_REGISTRY}/${AUTH_IMAGE}:${IMAGE_TAG}


                docker push \
                ${ECR_REGISTRY}/${PRODUCT_IMAGE}:${IMAGE_TAG}

                """
            }
        }


        stage('Deploy Application') {

            steps {

                dir("${ANSIBLE_DIR}") {

                    sh """

                    ansible-playbook \
                    playbooks/deploy.yml \
                    -e image_tag=${IMAGE_TAG}

                    """
                }
            }
        }

    }


    post {


        success {

            echo 'Application pipeline completed successfully.'
        }


        failure {

            echo 'Application pipeline failed.'
        }


        always {

            cleanWs()
        }

    }

}