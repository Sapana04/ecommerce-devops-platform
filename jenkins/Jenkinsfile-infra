pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        BOOTSTRAP_DIR = 'terraform/bootstrap'
        INFRA_DIR = 'terraform/infrastructure'
        ANSIBLE_DIR = 'ansible'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        stage('Check Terraform') {
            steps {
                sh 'terraform version'
            }
        }

        stage('Bootstrap - Terraform Init') {
            steps {
                dir("${BOOTSTRAP_DIR}") {
                    sh 'terraform init -upgrade'
                }
            }
        }

        stage('Bootstrap - Terraform Validate') {
            steps {
                dir("${BOOTSTRAP_DIR}") {
                    sh 'terraform validate'
                }
            }
        }

        stage('Bootstrap - Terraform Plan') {
            steps {
                dir("${BOOTSTRAP_DIR}") {
                    sh 'terraform plan -out=bootstrap.tfplan'
                }
            }
        }

        stage('Bootstrap - Terraform Apply') {
            steps {
                dir("${BOOTSTRAP_DIR}") {
                    sh 'terraform apply -auto-approve bootstrap.tfplan'
                }
            }
        }

        stage('Infrastructure - Terraform Init') {
            steps {
                dir("${INFRA_DIR}") {
                    sh 'terraform init -reconfigure -upgrade'
                }
            }
        }

        stage('Infrastructure - Terraform Validate') {
            steps {
                dir("${INFRA_DIR}") {
                    sh 'terraform validate'
                }
            }
        }

        stage('Infrastructure - Terraform Format Check') {
            steps {
                dir("${INFRA_DIR}") {
                    sh 'terraform fmt -check -recursive'
                }
            }
        }

        stage('Infrastructure - Terraform Plan') {
            steps {
                dir("${INFRA_DIR}") {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Infrastructure - Terraform Apply') {
            steps {
                input message: 'Terraform plan successful. Apply infrastructure?'

                dir("${INFRA_DIR}") {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }

        stage('Wait For EC2 Instances') {
            steps {
                echo 'Waiting for EC2 instances to become ready...'
                sleep(time: 90, unit: 'SECONDS')
            }
        }

        stage('Configure Servers Using Ansible') {
            steps {
                dir("${ANSIBLE_DIR}") {
                    sh 'ansible-playbook playbooks/site.yml'
                }
            }
        }
    }

    post {

        success {
            echo 'Infrastructure provisioning completed successfully.'
        }

        failure {
            echo 'Infrastructure provisioning failed.'
        }

        always {
            cleanWs()
        }
    }
}